<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Secure default: cleartext (HTTP) is denied for ALL traffic, so
         payment/signing and CKB RPC calls (JoyID, indexer, Fiber) must stay TLS. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- The Agent-Gateway relay runs plaintext HTTP on the local network / tailnet
         (no TLS this wave — see agent-gateway-relay/deploy/agent-relay.service).
         Allow cleartext ONLY to those specific relay hosts. Add hosts here if the
         relay moves; do not switch to a global usesCleartextTraffic=true. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.68.134</domain>
        <domain includeSubdomains="true">wyltek-10700.tail6db685.ts.net</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
